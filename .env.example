# Public (client-side)
# Calendly popup URL (recommended). Example: https://calendly.com/<your-handle>/15min
NEXT_PUBLIC_CALENDLY_URL=

# Legacy fallback booking link (optional). If unset, FlowGrid uses Calendly or email.
NEXT_PUBLIC_BOOKING_URL=

# Optional socials (footer only shows them if set)
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_INSTAGRAM_URL=

# Server-side (intake forwarding)
# Optional Make.com (or any webhook endpoint) to receive lead submissions
MAKE_WEBHOOK_URL=

# sphinxOps (Sphinx Healing) — Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional: app URL for auth redirects (e.g. https://flowgrid.ca)
NEXT_PUBLIC_APP_URL=

